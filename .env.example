# STEM RADAR Configuration

# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Proxy if Telegram API is blocked in your network/region
# Supports HTTP, HTTPS, and SOCKS5 (e.g., http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# TELEGRAM_PROXY_URL=
# TELEGRAM_CONNECT_TIMEOUT=30.0

# Allowed Telegram User IDs (comma-separated integers).
# If empty, all users are allowed (not recommended).
# Find your ID using @userinfobot on Telegram.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Database Configuration
# Local SQLite database using async engine
DATABASE_URL=sqlite+aiosqlite:///data/stem_radar.db

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional AI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FastAPI REST Server & Security
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_secure_api_key_here
API_ADMIN_KEY=your_secure_admin_key_here
API_RATE_LIMIT_PER_MINUTE=60

# Optional Social Media APIs
X_API_BEARER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# External Multi-Domain Search Engine
EXTERNAL_SEARCH_ENABLED=true
EXTERNAL_SEARCH_TIMEOUT_SECONDS=4.0
# Out-of-the-box zero-config providers: DuckDuckGo, Wikipedia
# Optional API keys for premium providers:
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=


